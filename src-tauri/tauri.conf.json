{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RuEnTranslator",
  "version": "0.1.0",
  "identifier": "com.example.ruentranslator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Переводчик",
        "url": "index.html",
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "overlay",
        "title": "Перевод",
        "url": "overlay.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "resizable": false,
        "width": 700,
        "height": 450,
        "focus": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
